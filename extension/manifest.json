{
  "manifest_version": 3,
  "name": "Instant AI Seek — AI Image Detector",
  "version": "1.0.0",
  "description": "Detects AI-generated images entirely in your browser. No cloud, no data leaves your device.",
  "permissions": ["storage", "unlimitedStorage", "offscreen", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Instant AI Seek — AI Image Detector"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/onnxruntime-web/*.wasm"],
      "matches": ["<all_urls>"]
    }
  ]
}
